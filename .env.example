# --- General Settings ---
# Timezone for all containers to ensure consistent logging.
TZ=Etc/UTC

# --- User/Group IDs ---
# Set the user and group ID for services that access the filesystem.
# This prevents permission issues with the mounted volumes.
# On Linux, you can find your user's ID by running `id -u` and `id -g`.
ORCASLICER_PUID=1000
ORCASLICER_PGID=1000
SYNCTHING_PUID=1000
SYNCTHING_PGID=1000

# --- Bambu Lab Printer Details ---
# These are required for the bambu-exporter and the bridge-script to connect to your printer.
# You can find these on the printer's network settings screen or in the Bambu Handy app.
# The Access Code is found under the "LAN only mode" section.
BAMBU_PRINTER_IP=
BAMBU_ACCESS_CODE=
BAMBU_SERIAL_NUMBER=

# --- Grafana Settings ---
# These are the initial administrator credentials for the Grafana dashboard.
# You will be prompted to change the password on your first login.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# --- InvenTree Settings ---
# These variables configure the InvenTree service and its database.
INVENTREE_DB_NAME=inventree
INVENTREE_DB_USER=inventree
INVENTREE_DB_PASSWORD=changeme
# The fully-qualified domain name for your InvenTree instance.
# For local access, this can be http://<server_ip>:8000
INVENTREE_SITE_URL=http://localhost:8000
# A comma-separated list of trusted origins for CSRF protection.
# Add your server's IP and any domain names you use to access InvenTree.
INVENTREE_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# These are the initial administrator credentials for the InvenTree web application.
INVENTREE_ADMIN_USER=admin
INVENTREE_ADMIN_PASSWORD=changeme